{
  "compilerOptions": {
    // eslint 10 bundles its own types, which clash with @types/eslint-scope (pulled in by webpack).
    // Skip type-checking of node_modules .d.ts files, matching the root and augen tsconfigs.
    "skipLibCheck": true,
    "strictNullChecks": true,
    "baseUrl": "./",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "dist",
    "target": "es2019",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler" // to skip errors related to import of types from ts files
  },
  "exclude": [
    "./node_modules",
    "./*.ts",
    "./dist",
  	"./package"
  ]
}