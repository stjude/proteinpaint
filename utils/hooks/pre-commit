#!/bin/sh

set -e

STAGEDFILES=$(git diff --cached --name-only | sed 's| |\\ |g')

# doing per GDC requirements
pre-commit run --files "$STAGEDFILES"

# select changed/added file extensions where prettier format is preferred,
# for other file extensions nests, prettier rules might not be preferred,
# for example it nests html tags too much
FILES=$(git diff --cached --name-only --diff-filter=ACM "*.js" "*.ts" "*.mjs" "*.cjs" | sed 's| |\\ |g')

if [[ "$FILES" != "" ]]; then
	echo "Prettifying $FILES ..."

	# Prettify all selected files
	# configuration are under the `"prettier": {}` object in package.json
	echo "$FILES" | xargs npx prettier --no-semi --use-tabs --write

	# Add back the modified/prettified files to staging
	echo "$FILES" | xargs git add

	# lint against team preferences (flat config: eslint.config.js, node-based, no --env)
	echo "Linting ..."
	# only run eslint when there are staged .ts files (guard is portable across GNU and BSD)
	TSFILES=$(echo "$FILES" | grep "\.ts$" || true)
	if [ -n "$TSFILES" ]; then
		echo "$TSFILES" | xargs npx eslint
	fi

	# check for invalid use of .Inner reference
	echo "checking for forbidden .Inner. usage"
	set +e
	PRODINNER=$(echo "$FILES" | xargs grep -lr --exclude=\*ComponentApi.\* --exclude=\*.spec\* --exclude=\*dist\/ --exclude=\*test\/ --exclude=\*front.helpers\* --exclude=\*.md "\.Inner\.")
	set -e
	if [[ "$PRODINNER" != "" ]]; then
		echo "\n--- !!! forbidden use of .Inner. found in: !!! ---"
		echo "$PRODINNER\n"
		exit 1
	fi
fi

# Add Rust formatting and linting for files in the rust/src directory.
# We check if Rust files have been modified, run `cargo fmt` and `cargo clippy` on them.
RUST_FULL_PATHS=$(git diff --cached --name-only --diff-filter=ACM "*.rs" | sed 's| |\\ |g')

if [[ "$RUST_FULL_PATHS" != "" ]]; then
  echo "Formatting Rust files..."
  rustfmt $RUST_FULL_PATHS
  
  # Add back the formatted Rust files to staging
  echo "$RUST_FULL_PATHS" | xargs git add
  
  # TODO: Will add linting for Rust files at a later time
  
    # Return to original directory
  cd "$ORIG_DIR"
fi

# check the added lines, such as code comments and test names, after the steps above that can stage changes
cd "$(git rev-parse --show-toplevel)"
if git rev-parse -q --verify MERGE_HEAD > /dev/null; then
  # a merge commit: skip the lines that come from the merged branch, such as master, which are
  # already checked or public. The added lines of the diff from HEAD that are not also added in
  # the diff from MERGE_HEAD are turned into context lines, which keeps the line numbers
  ADDED=$(mktemp)
  trap 'rm -f "$ADDED"' EXIT
  git diff --cached -U0 --no-color --no-ext-diff MERGE_HEAD | awk '
    /^diff --git / { header = 1; next }
    header && /^\+\+\+ / { header = 0; file = substr($0, 7); next }
    /^\+/ { print file "\037" substr($0, 2) }
  ' > "$ADDED"
  git diff --cached -U0 --no-color --no-ext-diff HEAD | awk '
    FNR == NR { keep[$0] = 1; next }
    /^diff --git / { header = 1; print; next }
    header && /^\+\+\+ / { header = 0; file = substr($0, 7); print; next }
    /^\+/ && !((file "\037" substr($0, 2)) in keep) { print " " substr($0, 2); next }
    { print }
  ' "$ADDED" - | ./utils/hooks/check-text.sh diff "staged changes"
else
  git diff --cached -U0 --no-color --no-ext-diff | ./utils/hooks/check-text.sh diff "staged changes"
fi

exit 0
