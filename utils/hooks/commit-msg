#!/bin/bash

# STAGEDFILES="$(git diff --name-only --cached)"
# if [[ "$STAGEDFILES" == *"release.txt"* ]]; then
#   echo "skipped release note detection since release.txt is already staged"
#   exit 0
# fi

# remove the co-author lines, which are not included in a commit message, see AGENTS.md,
# and the blank lines that are left at the end
MSG="$(grep -v -i -E '^[[:space:]]*co-authored-by:' "$1")"
printf '%s\n' "$MSG" > "$1"

# check the message before it's used in the release notes
./utils/hooks/check-text.sh commit-msg "$1" || exit 1

MSG="$(cat $1)"
NOTES="$(cat release.txt)"
  
NOTES=$(node ./build/setReleaseText.cjs release.txt "$1")
if [[ "$NOTES" != "" ]]; then
  echo -e "$NOTES" > release.txt
fi
if [[ "$(git diff --name-only release.txt)" == 'release.txt' ]]; then
  echo "updating release notes ..."
  git add release.txt
fi

exit 0
